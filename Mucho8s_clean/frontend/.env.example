# Optional shared cloud database.
# If these are left empty, Mucho8s automatically uses this browser's localStorage.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional legacy FastAPI backend. Supabase takes priority when configured.
REACT_APP_BACKEND_URL=

# Optional product analytics and session replay.
# Create a PostHog project, then copy its project token and ingestion host.
REACT_APP_POSTHOG_PROJECT_TOKEN=
REACT_APP_POSTHOG_HOST=https://eu.i.posthog.com

# Optional Rive intro animation.
# Point to a public .riv asset (for example /animations/mucho-intro.riv).
# Leave empty to keep the current MuchoMoney8s SVG intro.
REACT_APP_RIVE_INTRO_SRC=
REACT_APP_RIVE_INTRO_STATE_MACHINE=
